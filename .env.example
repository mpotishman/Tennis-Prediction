# Production only: direct download of combined.csv or combined.csv.gz.
TENNIS_DATA_URL=https://example.com/combined.csv.gz

# Optional but recommended: SHA-256 of the uncompressed combined.csv.
TENNIS_DATA_SHA256=

# Optional: override where Python and the startup downloader read the dataset.
TENNIS_DATA_PATH=

# Optional for a private download URL, for example: Bearer <token>
TENNIS_DATA_AUTH_HEADER=
